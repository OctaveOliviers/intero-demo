{
  "schema_version": "1",
  "audit": "cord-ph",
  "databases": [
    "cord-ph"
  ],
  "database_summaries": {
    "cord-ph": "Per-birth intrapartum and neonatal intensive care data joined on baby patient for cord pH quality audit."
  },
  "description": "Cord pH audit bound to the cord-ph EMR. The primary entity is one baby / birth record in cord_ph_birth_records (the ALL region); the NICU region draws each baby's neonatal-unit course from nicu_admissions, joined back to the birth record by patient_code. Every audit value is a direct column read; mode of delivery carries a code map translating the database's text into the audit's coded set.",
  "identity": {
    "anchor": "cord-ph -> cord_ph_birth_records.patient_code",
    "grain": "one patient per birth record",
    "keys": [
      "cord-ph -> cord_ph_birth_records.patient_code",
      "cord-ph -> nicu_admissions.patient_code"
    ],
    "patient_grain_rule": "every criterion = this patient has >=1 matching row (EXISTS/IN over the anchor cord_ph_birth_records.patient_code), never a count-inflating join"
  },
  "regions": [
    {
      "id": "ALL",
      "sheet": "ALL",
      "kind": "row_per_entity",
      "data_range": "A2:AQ500",
      "row_id": {
        "cell": "A",
        "header": "Patient code"
      }
    },
    {
      "id": "NICU",
      "sheet": "NICU",
      "kind": "row_per_entity",
      "data_range": "A2:N500",
      "row_id": {
        "cell": "A",
        "header": "Age (hours) at NNU admission"
      }
    }
  ],
