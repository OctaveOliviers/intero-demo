  "criteria_bindings": [
    {
      "criterion_id": "delivery",
      "label": "Mode of delivery",
      "source": "cord-ph -> cord_ph_birth_records.delivery",
      "type": "category",
      "join_path": "direct column on the anchor row (no join)",
      "grain_rule": "the patient's birth record has this delivery value",
      "from": "audit_field+db_column"
    },
    {
      "criterion_id": "gestation_weeks",
      "label": "Gestation (completed weeks)",
      "source": "cord-ph -> cord_ph_birth_records.gestation_weeks",
      "type": "number",
      "join_path": "direct column on the anchor row (no join)",
      "grain_rule": "the patient's birth record has completed gestation weeks in the implied range",
      "from": "audit_field+db_column"
    },
    {
      "criterion_id": "admitted_to_nicu",
      "label": "Admitted to NICU",
      "source": "cord-ph -> cord_ph_birth_records.admitted_to_nicu",
      "type": "category",
      "join_path": "direct column on the anchor row (no join)",
      "grain_rule": "the patient's birth record is flagged admitted to NICU",
      "from": "audit_field+db_column"
    },
    {
      "criterion_id": "encounter_start",
      "label": "Delivery / encounter date",
      "source": "cord-ph -> encounters.start",
      "type": "date",
      "join_path": "cord_ph_birth_records.encounter -> encounters.id",
      "grain_rule": "the patient's birth encounter has a start date in the implied range (EXISTS over the anchor's encounter)",
      "from": "db_column"
    },
    {
      "criterion_id": "patient_birthdate",
      "label": "Patient age (date of birth)",
      "source": "cord-ph -> patients.birthdate",
      "type": "date",
      "join_path": "cord_ph_birth_records.baby_patient -> patients.id",
      "grain_rule": "the baby has a birthdate in the implied range (older-than-5y -> birthdate <= date(:as_of,'-5 years'))",
      "from": "db_column"
    }
  ],
  "fixed_criteria": [
    {
      "criterion_id": "gestation_weeks",
      "label": "Gestation (completed weeks)",
      "type": "number",
      "predicate": {
        "op": "gte",
        "value": 37,
        "unit": "weeks"
      },
      "display": "Gestation \u2265 37 weeks"
    },
    {
      "criterion_id": "encounter_start",
      "label": "Delivery / encounter date",
      "type": "date",
      "predicate": {
        "op": "between",
        "value": [
          "2025-04-01",
          "2026-03-31"
        ]
      },
      "display": "Delivery date 1 Apr 2025 \u2013 31 Mar 2026"
    }
  ],
  "not_expressible": [
    {
      "criterion_id": "documented_clinical_concern",
      "label": "Documented clinical concern",
      "source": "cord-ph -> clinical_notes.text",
      "reason": "only in free-text; no structured column"
    }
  ],
