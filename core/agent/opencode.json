{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote LLM",
      "options": {
        "baseURL": "{env:LLM_API_BASE}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "{env:LLM_MODEL}": {}
      }
    }
  },
  "permission": {
    "*": "deny",
    "sql_execute": "allow",
    "lookup_execute": "allow",
    "skill": {
      "*": "deny",
      "cell-fill": "allow"
    },
    "table_create": "deny",
    "table_read": "deny",
    "table_write_values": "deny",
    "populate_region": "deny",
    "notes_write": "deny",
    "notes_read": "deny",
    "bash": "deny",
    "edit": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "todowrite": "deny",
    "question": "ask",
    "doom_loop": "ask"
  }
}
