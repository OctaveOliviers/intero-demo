{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote LLM",
      "options": {
        "baseURL": "{env:LLM_TABLE_API_BASE}",
        "apiKey": "{env:LLM_TABLE_API_KEY}"
      },
      "models": {
        "{env:LLM_TABLE_MODEL}": {}
      }
    }
  },
  "permission": {
    "*": "deny",
    "sql_execute": "allow",
    "lookup_execute": "allow",
    "search_execute": "allow",
    "describe_execute": "allow",
    "join_paths_execute": "allow",
    "catalog_execute": "allow",
    "skill": {
      "*": "deny",
      "table-fill": "allow",
      "navigate": "allow",
      "evidence": "allow"
    },
    "question": "ask",
    "doom_loop": "ask"
  }
}
