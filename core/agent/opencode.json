{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote LLM",
      "options": {
        "baseURL": "{env:LLM_API_BASE}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "{env:LLM_MODEL}": {}
      }
    }
  },
  "permission": {
    "*": "deny",
    "sql_execute": "allow",
    "lookup_execute": "allow",
    "skill": {
      "*": "deny",
      "cell-fill": "allow"
    },
    "question": "ask",
    "doom_loop": "ask"
  }
}
