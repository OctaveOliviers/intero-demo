# Per-stage LLM config lives in models.json / models.local.json
# (docs/mvp/contracts/model-config.md). Each stage names an env var (api_key_env)
# that holds its bearer key; put the actual keys here (or, better, in .env.local).
#
# SECRETS: prefer `.env.local` over `.env`. `.env.local` is gitignored AND never
# templated, so a `cp .env.example .env` (the quickstart) can't wipe your keys.
# core/config.py loads `.env` then `.env.local` (override), so .env.local wins.
#
# Example keys referenced by a models.local.json (names are illustrative —
# match whatever your stages' api_key_env fields say):
# AZURE_LLM_API_KEY=
# AZURE_GPT_API_KEY=

# Legacy single-endpoint fallback (used only when a stage has NO models.json
# entry): an OpenAI-compatible endpoint hit at {LLM_API_BASE}/chat/completions.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Optional: request timeout in seconds (reasoning models / large mappings can
# exceed the 120s default).
# LLM_TIMEOUT=600
