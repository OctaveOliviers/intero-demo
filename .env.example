# OpenAI-compatible LLM endpoint used by both the opencode agent and the
# deterministic indexing builders.
#
# The endpoint MUST support both:
#   - POST {LLM_API_BASE}/responses        (OpenAI Responses API — used by indexing)
#   - POST {LLM_API_BASE}/chat/completions (used by the opencode agent)
#
# OpenAI's own API works. Many self-hosted gateways only implement
# /chat/completions and will fail on the indexing step.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
